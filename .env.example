NODE_ENV=development
PORT=3002
API_PREFIX=api
CORS_ORIGIN=*
APP_URL=http://localhost

JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_EXPIRES_IN=1d
JWT_ALLOW_UNAUTHENTICATED=false

# Connector guard note:
# Laravel JwtOrHeader currently allows requests through even without JWT/header.
# Keep true while comparing parity, set false when you want stricter NestJS auth.
CONNECTOR_ALLOW_UNAUTHENTICATED=true
CONNECTOR_TOKEN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=

DB_HOST_VOICE=127.0.0.1
DB_PORT_VOICE=3306
DB_DATABASE_VOICE=
DB_USERNAME_VOICE=root
DB_PASSWORD_VOICE=

DB_HOST_PBX=127.0.0.1
DB_PORT_PBX=3306
DB_DATABASE_PBX=
DB_USERNAME_PBX=root
DB_PASSWORD_PBX=

EXPORT_STORAGE_PATH=storage/exports
