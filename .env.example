# ============================================================
# MASVN Contact Popup - NestJS Migration
# Copy file này thành .env và điền thông tin thật
# ============================================================

NODE_ENV=development
PORT=3000

# ============================================================
# JWT - Phải TRÙNG với JWT_SECRET trong Laravel .env
# ============================================================
JWT_SECRET=go5ZVUFiJLQhMWqqDIZX0cp0p2EkerUaIM16oSGGxwIZr6TRO4RRHgyekPxMbUGm
JWT_ALGO=HS256

# ============================================================
# DATABASE CHÍNH (tương đương mysql/pgsql trong Laravel)
# DB_CONNECTION: 'mysql' hoặc 'pgsql' (postgres)
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=midesk_contactpopup
DB_USERNAME=root
DB_PASSWORD=

# ============================================================
# DATABASE VOICE / CALL LOG (voice_server_1 trong Laravel)
# ============================================================
DB_CONNECTION_VOICE=mysql
DB_HOST_VOICE=127.0.0.1
DB_PORT_VOICE=3306
DB_DATABASE_VOICE=midesk_contactpopup
DB_USERNAME_VOICE=root
DB_PASSWORD_VOICE=

# ============================================================
# DATABASE PBX (pbx01 trong Laravel)
# ============================================================
DB_CONNECTION_PBX=mysql
DB_HOST_PBX=127.0.0.1
DB_PORT_PBX=3306
DB_DATABASE_PBX=midesk_contactpopup
DB_USERNAME_PBX=root
DB_PASSWORD_PBX=
